# Copy to .env.local to run against the real arena-api backend instead of mock data.
# Omit this file entirely (or set NEXT_PUBLIC_API_MODE=mock) to keep using mock mode -
# the permanent demo path that needs no backend running at all.

NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1

# Dormant unless set - blank disables Sentry entirely (see src/instrumentation-client.ts).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local

# Dormant unless set - GoogleSignInButton renders nothing without this (safe to be public, no
# client secret involved - see the component's own comment). Must match arena-api's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dormant unless set - /map falls back to the stylized 3D radar view without this (see
# GoogleMapView's own comment on why a real map isn't a privacy regression either way).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
