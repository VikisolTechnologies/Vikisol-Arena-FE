# Copy this file to .env.test and fill in real values. .env.test is gitignored (see .gitignore's
# blanket `.env*` rule + the explicit `!.env.test.example` exception added for this file) - never
# put real credentials in a committed file.
#
# Values for the five ARENA_*_EMAIL accounts below, and the shared password, are documented in
# TEST-LOGINS.md at the repo root (all five are demo/seeded accounts on the app's one existing
# deployment, meant for exactly this kind of testing - see that file for what each account has
# pre-seeded and TESTING.md's "Data safety" section for the rules this suite follows around them).

# Which deployment to test against. Defaults to the live app if unset - there is currently only
# one real environment (verified 2026-08-14: the custom domain and the raw *.up.railway.app host
# serve the identical build, same /version commit hash on both).
ARENA_BASE_URL=https://arena.vikisol.in

# Demo accounts, one per role (password is shared across all five - see TEST-LOGINS.md)
ARENA_TALENT_EMAIL=demo.talent@vikisol.dev
ARENA_TALENT_PASSWORD=

ARENA_COMPANY_ADMIN_EMAIL=demo.enterprise@vikisol.dev
ARENA_COMPANY_ADMIN_PASSWORD=

ARENA_RECRUITER_EMAIL=demo.recruiter@vikisol.dev
ARENA_RECRUITER_PASSWORD=

ARENA_HIRING_MANAGER_EMAIL=demo.hiringmanager@vikisol.dev
ARENA_HIRING_MANAGER_PASSWORD=

ARENA_PLATFORM_ADMIN_EMAIL=admin@vikisol.dev
ARENA_PLATFORM_ADMIN_PASSWORD=
